{
  "name": "swb-entscheidet-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Qualitäts-Checks für schwalbach-entscheidet.de (nur CI-Werkzeuge, nicht Teil der Website)",
  "scripts": {
    "check:html": "html-validate \"**/*.html\"",
    "check:a11y": "pa11y-ci --config .pa11yci.json",
    "check:lighthouse": "lhci autorun --config=lighthouserc.json"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "html-validate": "11.16.1",
    "pa11y-ci": "4.1.1"
  }
}
